# Supabase — find these in your project dashboard under Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-anon-key

# Service role key — NEVER expose this client-side (used only in API routes)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-service-role-key

# Admin login — choose strong values and keep them secret
ADMIN_PASSWORD=choose-a-strong-password-here
ADMIN_SECRET=choose-a-random-64-char-string-here

# Public site URL — used to generate dashboard links in notifications
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# Notifications — optional webhook for new submission alerts
# Works with Discord, Slack, ntfy.sh, or any HTTP JSON endpoint
# Discord: https://discord.com/api/webhooks/your-id/your-token
# Slack:   https://hooks.slack.com/services/your-token
NOTIFY_WEBHOOK_URL=
